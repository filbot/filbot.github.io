{
  "permissions": {
    "allow": [
      "Bash(hugo *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-build.sh",
            "timeout": 300,
            "statusMessage": "Checking the Hugo build"
          }
        ]
      }
    ]
  }
}
